/* ═══════════════════════════════════════════════════════════
   TEMA INSTITUCIONAL — UMSA MEDICINA
   Tema complementario al styles.qss principal
   ═══════════════════════════════════════════════════════════ */

/* Reset y fondo general */
QWidget {
    background-color: #F8FAFC;
    color: #1E293B;
    font-family: 'Segoe UI', 'Inter', 'Roboto', Helvetica, Arial, sans-serif;
    font-size: 13px;
}

/* Encabezados y títulos */
QLabel#TituloInstitucional {
    font-size: 18px;
    font-weight: 800;
    color: #0F2C59;
    letter-spacing: 0.5px;
}

QLabel#Subtitulo {
    font-size: 13px;
    color: #64748B;
    font-weight: 500;
}

/* Campos de texto */
QLineEdit, QSpinBox {
    background-color: #F8FAFC;
    border: 1.5px solid #E2E8F0;
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 13px;
    color: #1E293B;
}

QLineEdit:focus, QSpinBox:focus {
    border: 2px solid #2563EB;
    background-color: #FFFFFF;
}

/* Botones principales */
QPushButton {
    font-size: 13px;
    font-weight: 600;
    border-radius: 8px;
    padding: 10px 18px;
}

QPushButton#BtnPrimario {
    background-color: #2563EB;
    color: #FFFFFF;
    border: none;
}

QPushButton#BtnPrimario:hover {
    background-color: #1D4ED8;
}

QPushButton#BtnExito {
    background-color: #059669;
    color: #FFFFFF;
    border: none;
}

QPushButton#BtnExito:hover {
    background-color: #047857;
}

/* Pestañas (QTabWidget) */
QTabWidget::pane {
    border: 1px solid #E2E8F0;
    background: #FFFFFF;
    border-radius: 10px;
    top: -1px;
}

QTabBar::tab {
    background: #F1F5F9;
    color: #64748B;
    padding: 12px 28px;
    font-weight: 600;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    margin-right: 3px;
}

QTabBar::tab:selected {
    background: #FFFFFF;
    color: #2563EB;
    border-top: 3px solid #2563EB;
}

/* Tarjetas y Contenedores */
QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    margin-top: 24px;
    font-weight: 700;
    color: #0F2C59;
    padding: 20px 16px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 18px;
    padding: 0 8px;
    background-color: #FFFFFF;
}

/* Barra de estado inferior */
QStatusBar {
    background-color: #0F172A;
    color: #94A3B8;
    font-weight: 500;
    font-size: 12px;
}
